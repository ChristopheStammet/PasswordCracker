      "cell_type": "markdown",
      "source": [
        "# Angriff Nummer 4\n",
        "## Gezielte Veränderungen\n",
        "\n",
        "\n",
        "\n",
        "> Viele Passwörter, die Sonderzeichen enthalten müssen, sind immer auf die gleiche Weise verändert, indem z.B. ein 'e' zu einem '€' oder einer '3', ein 's' zu einem '$' oder ein 'a' zu einem '@' werden.\n",
        "\n",
        "Versuche hier, einige solche Veränderungen (substitutions) zu definieren und lasse den Computer dann sämtliche Veränderungen austesten.\n",
        "\n"
      ],
      "metadata": {
        "id": "u41JZP-3Fgfr"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ==== Füge mögliche Veränderungen in diese Liste hinzu ====\n",
        "# ==== Links vom : ist das zu ersetzende Symbol\n",
        "# ==== Rechts vom : ist die Liste der möglichen Veränderungen\n",
        "# ==== Setze das Symbol der Veränderung zwischen die '' oder füge weitere Zeilen hinzu\n",
        "\n",
        "substitutions = {\n",
        "    'a': ['a', '@', ''],\n",
        "    'e': ['e', ''],\n",
        "}\n",
        "\n",
        "# ==== Hier kannst du natürlich auch die Liste der Charaktere sowie die Länge des Passwortes anpassen\n",
        "charlist = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z']\n",
        "testlength = 4\n",
        "# ==========================\n",
        "\n",
        "def apply_substitutions(word, subs):\n",
        "    \"\"\"Generate all variants of word by substituting each character with all allowed substitutions.\"\"\"\n",
        "    # For each character, get the list of substitutions or the char itself\n",
        "    lists_of_chars = [subs.get(c, [c]) for c in word]\n",
        "    # Cartesian product of these lists gives all variants\n",
        "    for variant_tuple in itertools.product(*lists_of_chars):\n",
        "        yield \"\".join(variant_tuple)\n",
        "\n",
        "def generate_strings(chars, length):\n",
        "    for combo in itertools.product(chars, repeat=length):\n",
        "        yield \"\".join(combo)\n",
        "\n",
        "total_base = len(charlist) ** testlength\n",
        "\n",
        "# Since substitution expansions multiply variants, total variants is much larger — warn pupils\n",
        "\n",
        "for base_word in tqdm(generate_strings(charlist, testlength), total=total_base):\n",
        "    for variant in apply_substitutions(base_word, substitutions):\n",
        "      password_hash = hash(variant)\n",
        "      if password_hash in dataleak_dict.values():\n",
        "          name = get_name_by_hash(dataleak_dict, password_hash)\n",
        "          print(f\"Password gefunden: {variant} ist das Passwort von {name}\")"
      ],
